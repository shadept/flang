# Compiler output: `flang build` emits into each project's own build/.
compiler/build/
lib/*/build/
tools/*/build/
stdlib/*/build/
tests/runner/build/

# Installed compilers and stage artifacts (dotnet run build.cs).
dist/

# Cold-start binary built from the committed seed C, which IS tracked.
boot/*/flang-seed

# Toolchain intermediates and binaries.
*.obj
*.exe
*.fir
*.idb
*.pdb
*.ilk
*.dSYM/
/test

# Generated C and FLang files (compiler output).
*.generated.c
*.generated.f

# Generated FFI vendor bindings.
vendor/

# Profiler output (RFC-025).
*.folded

# cst_explorer ad-hoc diagnostic dumps.
tools/cst_explorer/out.json

# Intermediate C from compilation, but not hand-written stdlib/example sidecars.
examples/**/*.c
tests/**/*.c

# Test harness: source files only.
tests/harness/**
!tests/harness/**/
!tests/harness/**/*.f
tests/harness/**/*.generated.f

# Examples: source and project files only.
examples/**
!examples/**/
!examples/**/*.f
!examples/**/src/**/*.c
examples/**/*.generated.f
!examples/**/*.toml
!examples/**/*.md
!examples/**/.gitignore

# Editor and agent state.
.vscode/
.idea/
.claude/
